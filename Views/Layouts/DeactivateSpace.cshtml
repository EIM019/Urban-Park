@model CarparkManagementSystem.ViewModels.Layouts.InactiveNoteViewModel

@{
    ViewData["Title"] = $"Deactivate Space {Model.SpaceNumber}";
}

<div class="container mt-4" style="max-width: 600px;">

    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a asp-action="Index">Layouts</a>
            </li>
            <li class="breadcrumb-item">
                <a asp-action="Details" asp-route-id="@Model.SiteId">@Model.SiteName</a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">Deactivate Space @Model.SpaceNumber</li>
        </ol>
    </nav>

    <div class="card border-warning">
        <div class="card-header bg-warning text-dark">
            <h5 class="mb-0">
                <i class="bi bi-cone-striped me-2"></i>
                Deactivate Space @Model.SpaceNumber — @Model.SiteName
            </h5>
        </div>
        <div class="card-body">

            <div class="alert alert-warning d-flex align-items-center" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                <div>
                    This space will be marked as <strong>inactive</strong> and will no longer be available for booking.
                </div>
            </div>

            <form asp-action="DeactivateSpace" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <input type="hidden" asp-for="ParkingSpaceId" />
                <input type="hidden" asp-for="SiteId" />
                <input type="hidden" asp-for="SiteName" />
                <input type="hidden" asp-for="SpaceNumber" />

                <div class="mb-3">
                    <label asp-for="InactiveNote" class="form-label fw-semibold">
                        Reason / Note <span class="text-danger">*</span>
                    </label>
                    <textarea asp-for="InactiveNote"
                              class="form-control"
                              rows="3"
                              placeholder="e.g. Under maintenance, structural damage, reserved for works vehicle…"></textarea>
                    <span asp-validation-for="InactiveNote" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <div class="form-check">
                        <input asp-for="IsInactivePermanent"
                               class="form-check-input"
                               type="checkbox"
                               id="IsInactivePermanent" />
                        <label class="form-check-label" for="IsInactivePermanent">
                            Mark as <strong>permanently</strong> inactive
                            <small class="text-muted d-block">
                                Leave unchecked if this is a temporary deactivation.
                            </small>
                        </label>
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-warning">
                        <i class="bi bi-cone-striped me-1"></i> Confirm Deactivation
                    </button>
                    <a asp-action="Details" asp-route-id="@Model.SiteId" class="btn btn-outline-secondary">
                        Cancel
                    </a>
                </div>
            </form>

        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}