@using Microsoft.AspNetCore.Identity
@using CarparkManagementSystem.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav align-items-lg-center gap-lg-2">
@if (SignInManager.IsSignedIn(User))
{
    <li class="nav-item">
        <a class="nav-link user-chip" asp-area="Identity" asp-page="/Account/Manage/Index" title="Manage account">
            @User.Identity?.Name
        </a>
    </li>
    <li class="nav-item">
        <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
            <button type="submit" class="btn btn-outline-light btn-sm rounded-pill px-3">Logout</button>
        </form>
    </li>
}
else
{
    <li class="nav-item">
        <a class="btn btn-light btn-sm rounded-pill px-3" asp-area="Identity" asp-page="/Account/Login">Login</a>
    </li>
}
</ul>
